# Copy to .env.local for local dev, and add the same key in Vercel project settings.
# Get a key at https://console.anthropic.com — Settings > API Keys.
#
# This is the FALLBACK key. The app is bring-your-own-key: if a visitor pastes
# their own key in the UI, that one is used for their request and this is ignored.
# Leave it blank to force every visitor to bring their own key (so a public demo
# never spends your credits).
ANTHROPIC_API_KEY=

# Optional. The model that does the reviewing — deliberately a small, cheap one,
# because the whole point is that a cheap model can catch an expensive one's
# mistakes. Defaults to Haiku if unset.
REVIEWER_MODEL=claude-haiku-4-5-20251001
