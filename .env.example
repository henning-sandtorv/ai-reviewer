# Copy to .env.local for local dev, and add the same keys in Vercel project settings.
#
# These are FALLBACK keys. The app is bring-your-own-key: if a visitor pastes their
# own key in the UI, that one is used for their request and these are ignored.
# Leave them blank to force every visitor to bring their own key (so a public demo
# never spends your credits).

# Anthropic — https://console.anthropic.com (Settings > API Keys)
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible provider (OpenRouter, Groq, Together, local
# Ollama / LM Studio, …). The base URL is set per-request in the UI.
OPENAI_API_KEY=

# Optional. Overrides the default reviewer model for whichever provider is chosen.
# Defaults: Anthropic -> claude-haiku-4-5-20251001, OpenAI -> gpt-4o-mini.
# Keep it small and cheap — the whole point is that a cheap model still catches an
# expensive one's mistakes.
REVIEWER_MODEL=
